---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ui/ToolCard.astro';
import { InstallPwaButton } from '../components/ui/InstallPwaButton';
import { ALL_TOOLS } from '../lib/tools';
import lucide from 'lucide-react';
const { FileText, Image: ImageIcon, Type, Code, Clock, Heart } = lucide;

const pdfTools = ALL_TOOLS.filter(t => t.category === 'pdf');
const imageTools = ALL_TOOLS.filter(t => t.category === 'image');
const textTools = ALL_TOOLS.filter(t => t.category === 'text');
const devTools = ALL_TOOLS.filter(t => t.category === 'dev');

import { useTranslations, translations, type Locale } from '../lib/i18n';
const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);
---

<BaseLayout>
	<!-- Hero Section -->
	<section class="relative pt-10 md:pt-14 pb-12 md:pb-16 border-b border-zinc-200/80 dark:border-zinc-800/80">
		<div class="container mx-auto px-4 text-center max-w-4xl">
			<h1 class="text-4xl sm:text-5xl md:text-6xl font-bold font-outfit tracking-tight text-zinc-900 dark:text-zinc-50 mb-4 leading-[1.15]">
				{t('hero.title')} <span class="text-zinc-500 dark:text-zinc-400 font-normal">{t('hero.subtitle')}</span>
			</h1>
			
			<p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto mb-8 leading-relaxed">
				{t('hero.description')}
			</p>
			
			<div class="flex flex-wrap justify-center items-center gap-3">
				<a href="#pdf" class="px-4 py-2 bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-800 rounded-lg text-sm font-medium transition-colors hover:border-zinc-400 dark:hover:border-zinc-600 flex items-center gap-2">
					<span class="w-5 h-5 rounded bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center">
						<FileText size={13} />
					</span>
					{t('hero.cta.pdf')}
				</a>
				<a href="#image" class="px-4 py-2 bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-800 rounded-lg text-sm font-medium transition-colors hover:border-zinc-400 dark:hover:border-zinc-600 flex items-center gap-2">
					<span class="w-5 h-5 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center">
						<ImageIcon size={13} />
					</span>
					{t('hero.cta.image')}
				</a>
				<a href="#text" class="px-4 py-2 bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-800 rounded-lg text-sm font-medium transition-colors hover:border-zinc-400 dark:hover:border-zinc-600 flex items-center gap-2">
					<span class="w-5 h-5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
						<Type size={13} />
					</span>
					{t('hero.cta.text')}
				</a>
				<a href="#dev" class="px-4 py-2 bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-800 rounded-lg text-sm font-medium transition-colors hover:border-zinc-400 dark:hover:border-zinc-600 flex items-center gap-2">
					<span class="w-5 h-5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 flex items-center justify-center">
						<Code size={13} />
					</span>
					{t('hero.cta.dev')}
				</a>
			</div>

			<div class="mt-6 flex justify-center">
				<InstallPwaButton client:only="react" />
			</div>
		</div>
	</section>

	<!-- Quick Category Navigation Bar -->
	<nav aria-label="Category Navigation" class="sticky top-16 z-30 bg-zinc-50/90 dark:bg-zinc-950/90 backdrop-blur-md border-b border-zinc-200/80 dark:border-zinc-800/80 py-2.5 mb-10 transition-colors">
		<div class="container mx-auto px-4 flex items-center justify-between gap-4 overflow-x-auto">
			<div class="flex items-center gap-1.5 min-w-max text-sm">
				<a href="#pdf" class="px-3 py-1 rounded-md font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/60 dark:hover:bg-zinc-800/60 transition-colors">
					{t('cat.pdf')}
				</a>
				<a href="#image" class="px-3 py-1 rounded-md font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/60 dark:hover:bg-zinc-800/60 transition-colors">
					{t('cat.image')}
				</a>
				<a href="#text" class="px-3 py-1 rounded-md font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/60 dark:hover:bg-zinc-800/60 transition-colors">
					{t('cat.text')}
				</a>
				<a href="#dev" class="px-3 py-1 rounded-md font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/60 dark:hover:bg-zinc-800/60 transition-colors">
					{t('cat.dev')}
				</a>
			</div>
			<div class="text-xs text-zinc-500 dark:text-zinc-400 font-medium hidden sm:block">
				34 local utilities
			</div>
		</div>
	</nav>

	<div class="container mx-auto px-4 pb-24 space-y-16">
		<!-- Favorites Section -->
		<section id="favorite-tools-section" class="hidden scroll-mt-32">
			<div class="flex items-center gap-3.5 mb-6">
				<div class="w-10 h-10 bg-rose-100 dark:bg-rose-900/40 text-rose-600 dark:text-rose-400 rounded-xl flex items-center justify-center">
					<Heart size={20} className="fill-rose-500" />
				</div>
				<div>
					<h2 class="text-2xl md:text-3xl font-bold font-outfit text-zinc-900 dark:text-zinc-50">{t('ui.favorites') || 'Favorites'}</h2>
					<p class="text-zinc-600 dark:text-zinc-400 text-sm mt-0.5">{t('ui.favorites_desc') || 'Your most loved tools'}</p>
				</div>
			</div>
			<div 
				id="favorite-tools-grid" 
				data-label={t('ui.favorites') || 'Favorite'} 
				data-translations={JSON.stringify(translations[lang])}
				data-lang={lang}
			 class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"
			>
				<!-- Injected via script -->
			</div>
		</section>

		<!-- Recent Tools Section -->
		<section id="recent-tools-section" class="hidden scroll-mt-32">
			<div class="flex items-center gap-3.5 mb-6">
				<div class="w-10 h-10 bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-50 rounded-xl flex items-center justify-center">
					<Clock size={20} />
				</div>
				<div>
					<h2 class="text-2xl md:text-3xl font-bold font-outfit text-zinc-900 dark:text-zinc-50">{t('recent.title')}</h2>
					<p class="text-zinc-600 dark:text-zinc-400 text-sm mt-0.5">{t('recent.subtitle')}</p>
				</div>
			</div>
			<div 
				id="recent-tools-grid" 
				data-label={t('recent.tag')} 
				data-translations={JSON.stringify(translations[lang])}
				data-lang={lang}
			 class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"
			>
				<!-- Injected via script -->
			</div>
		</section>
		
		<!-- PDF Section -->
		<section id="pdf" class="scroll-mt-32">
			<div class="flex items-center gap-3.5 mb-6">
				<div class="w-10 h-10 bg-rose-100 dark:bg-rose-900/30 text-rose-600 dark:text-rose-400 rounded-xl flex items-center justify-center">
					<FileText size={20} />
				</div>
				<div>
					<h2 class="text-2xl md:text-3xl font-bold font-outfit text-zinc-900 dark:text-zinc-50">{t('cat.pdf')}</h2>
					<p class="text-zinc-600 dark:text-zinc-400 text-sm mt-0.5">{t('cat.pdf.desc')}</p>
				</div>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
				{pdfTools.map(tool => (
					<ToolCard 
						{...tool}
						title={t(`tool.${tool.id}.title`)}
						description={t(`tool.${tool.id}.desc`)}
						color="rose" 
					/>
				))}
			</div>
		</section>

		<!-- Image Section -->
		<section id="image" class="scroll-mt-32">
			<div class="flex items-center gap-3.5 mb-6">
				<div class="w-10 h-10 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-xl flex items-center justify-center">
					<ImageIcon size={20} />
				</div>
				<div>
					<h2 class="text-2xl md:text-3xl font-bold font-outfit text-zinc-900 dark:text-zinc-50">{t('cat.image')}</h2>
					<p class="text-zinc-600 dark:text-zinc-400 text-sm mt-0.5">{t('cat.image.desc')}</p>
				</div>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
				{imageTools.map(tool => (
					<ToolCard 
						{...tool}
						title={t(`tool.${tool.id}.title`)}
						description={t(`tool.${tool.id}.desc`)}
						color="blue" 
					/>
				))}
			</div>
		</section>

		<!-- Text Section -->
		<section id="text" class="scroll-mt-32">
			<div class="flex items-center gap-3.5 mb-6">
				<div class="w-10 h-10 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 rounded-xl flex items-center justify-center">
					<Type size={20} />
				</div>
				<div>
					<h2 class="text-2xl md:text-3xl font-bold font-outfit text-zinc-900 dark:text-zinc-50">{t('cat.text')}</h2>
					<p class="text-zinc-600 dark:text-zinc-400 text-sm mt-0.5">{t('cat.text.desc')}</p>
				</div>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
				{textTools.map(tool => (
					<ToolCard 
						{...tool}
						title={t(`tool.${tool.id}.title`)}
						description={t(`tool.${tool.id}.desc`)}
						color="emerald" 
					/>
				))}
			</div>
		</section>

		<!-- Developer Section -->
		<section id="dev" class="scroll-mt-32">
			<div class="flex items-center gap-3.5 mb-6">
				<div class="w-10 h-10 bg-zinc-100 dark:bg-zinc-800/40 text-zinc-700 dark:text-zinc-300 rounded-xl flex items-center justify-center">
					<Code size={20} />
				</div>
				<div>
					<h2 class="text-2xl md:text-3xl font-bold font-outfit text-zinc-900 dark:text-zinc-50">{t('cat.dev')}</h2>
					<p class="text-zinc-600 dark:text-zinc-400 text-sm mt-0.5">{t('cat.dev.desc')}</p>
				</div>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
				{devTools.map(tool => (
					<ToolCard 
						{...tool}
						title={t(`tool.${tool.id}.title`)}
						description={t(`tool.${tool.id}.desc`)}
						color="purple" 
					/>
				))}
			</div>
		</section>
	</div>

	<!-- Trust & Architecture Banner -->
	<section class="bg-zinc-900 border-t border-zinc-800 py-16 text-zinc-100">
		<div class="container mx-auto px-4">
			<div class="max-w-3xl mb-8">
				<h2 class="text-2xl md:text-3xl font-bold font-outfit text-white mb-3">
					{t('trust.title')}
				</h2>
				<p class="text-zinc-400 text-base leading-relaxed">
					{t('trust.description')}
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-5 pt-6 border-t border-zinc-800/80">
				<div class="p-5 rounded-xl bg-zinc-950/40 border border-zinc-800">
					<div class="text-white font-bold text-base mb-1.5">0 {t('trust.uploaded')}</div>
					<p class="text-zinc-400 text-xs leading-relaxed">{t('footer.privacy.desc')}</p>
				</div>
				<div class="p-5 rounded-xl bg-zinc-950/40 border border-zinc-800">
					<div class="text-white font-bold text-base mb-1.5">100% {t('trust.client')}</div>
					<p class="text-zinc-400 text-xs leading-relaxed">{t('ui.local_processing_badge')} (WebAssembly & Web APIs)</p>
				</div>
				<div class="p-5 rounded-xl bg-zinc-950/40 border border-zinc-800">
					<div class="text-white font-bold text-base mb-1.5">{t('trust.free')}</div>
					<p class="text-zinc-400 text-xs leading-relaxed">{t('ui.privacy_promise_desc')}</p>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
import { ALL_TOOLS } from '../lib/tools';
import type { ToolDefinition } from '../lib/tools';
import { getRecentTools } from '../lib/recentTools';

	function updateRecentTools() {
		const recentIds = getRecentTools();
		const section = document.getElementById('recent-tools-section');
		const grid = document.getElementById('recent-tools-grid');

		if (recentIds.length > 0 && section && grid) {
			const tData = JSON.parse(grid.dataset.translations || '{}');
			section.classList.remove('hidden');
			const recentTools = recentIds
				.map((id: string) => ALL_TOOLS.find(tool => tool.id === id))
				.filter((tool: ToolDefinition | undefined): tool is ToolDefinition => tool != null)
				.slice(0, 3);

			grid.innerHTML = recentTools.map((tool: ToolDefinition) => {
				const currentLang = grid.dataset.lang || 'en';
				const href = currentLang === 'en' ? tool.href : `/${currentLang}${tool.href}`;
				const externalBadge = tool.isExternal 
					? `<span class="px-2 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 text-[10px] font-bold uppercase tracking-wider rounded border border-zinc-200 dark:border-zinc-700 group-hover:bg-zinc-900 dark:group-hover:bg-white group-hover:text-white dark:group-hover:text-zinc-900 transition-all">${tData['ui.external_label'] || 'External'}</span>`
					: '';
				return `
					<a href="${href}" class="group relative block p-5 md:p-6 bg-white dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800/90 rounded-xl transition-all duration-200 hover:border-zinc-300 dark:hover:border-zinc-700 hover:shadow-md overflow-hidden">
						<div class="relative z-10">
							<div class="flex items-center justify-between mb-4">
								<div class="inline-flex items-center justify-center w-11 h-11 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-50 group-hover:bg-zinc-900 dark:group-hover:bg-white group-hover:text-white dark:group-hover:text-zinc-900 transition-colors">
									<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
								</div>
								${externalBadge}
							</div>
							<h3 class="text-base md:text-lg font-bold text-zinc-900 dark:text-zinc-50 mb-1.5 font-outfit">${tData['tool.' + tool.id + '.title'] || tool.title}</h3>
							<p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed mb-4">${tData['tool.' + tool.id + '.desc'] || tool.description}</p>
							<div class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-100 transition-colors">${grid.dataset.label || 'Recently Used'}</div>
						</div>
					</a>
				`;
			}).join('');
		}
	}

	function updateFavoriteTools() {
		try {
			const favoriteIds = JSON.parse(localStorage.getItem('lumea_favorites') || '[]');
			const section = document.getElementById('favorite-tools-section');
			const grid = document.getElementById('favorite-tools-grid');

			if (section && grid) {
				if (favoriteIds.length > 0) {
					section.classList.remove('hidden');
					const tData = JSON.parse(grid.dataset.translations || '{}');
					const favoriteTools = favoriteIds
						.map((id: string) => ALL_TOOLS.find(tool => tool.id === id))
						.filter((tool: ToolDefinition | undefined): tool is ToolDefinition => tool != null);

					grid.innerHTML = favoriteTools.map((tool: ToolDefinition) => {
						const currentLang = grid.dataset.lang || 'en';
						const href = currentLang === 'en' ? tool.href : `/${currentLang}${tool.href}`;
						const externalBadge = tool.isExternal 
							? `<span class="px-2 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 text-[10px] font-bold uppercase tracking-wider rounded border border-zinc-200 dark:border-zinc-700 group-hover:bg-zinc-900 dark:group-hover:bg-white group-hover:text-white dark:group-hover:text-zinc-900 transition-all">${tData['ui.external_label'] || 'External'}</span>`
							: '';
						return `
							<a href="${href}" class="group relative block p-5 md:p-6 bg-white dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800/90 rounded-xl transition-all duration-200 hover:border-zinc-300 dark:hover:border-zinc-700 hover:shadow-md overflow-hidden">
								<div class="relative z-10">
									<div class="flex items-center justify-between mb-4">
										<button class="favorite-remove-btn inline-flex items-center justify-center w-11 h-11 rounded-lg bg-rose-50 dark:bg-rose-900/30 text-rose-500 dark:text-rose-400 hover:bg-rose-500 dark:hover:bg-rose-500 hover:text-white dark:hover:text-white transition-colors cursor-pointer" data-id="${tool.id}" aria-label="Remove from favorites">
											<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
										</button>
										${externalBadge}
									</div>
									<h3 class="text-base md:text-lg font-bold text-zinc-900 dark:text-zinc-50 mb-1.5 font-outfit">${tData['tool.' + tool.id + '.title'] || tool.title}</h3>
									<p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed mb-4">${tData['tool.' + tool.id + '.desc'] || tool.description}</p>
									<div class="text-xs font-semibold uppercase tracking-wider text-rose-500 dark:text-rose-400 group-hover:text-rose-600 dark:group-hover:text-rose-300 transition-colors">${grid.dataset.label || 'Favorite'}</div>
								</div>
							</a>
						`;
					}).join('');

					grid.querySelectorAll('.favorite-remove-btn').forEach(btn => {
						btn.addEventListener('click', (e) => {
							e.preventDefault();
							e.stopPropagation();
							const toolId = btn.getAttribute('data-id');
							if (toolId) {
								const currentFavorites = JSON.parse(localStorage.getItem('lumea_favorites') || '[]');
								const updatedFavorites = currentFavorites.filter((id: string) => id !== toolId);
								localStorage.setItem('lumea_favorites', JSON.stringify(updatedFavorites));
								window.dispatchEvent(new Event('lumea:favorites-updated'));
							}
						});
					});
				} else {
					section.classList.add('hidden');
				}
			}
		} catch {}
	}

	// Run on initial load and after transitions
	document.addEventListener('astro:page-load', () => {
		updateRecentTools();
		updateFavoriteTools();
	});
	window.addEventListener('lumea:favorites-updated', updateFavoriteTools);
</script>


